@model IEnumerable<VotacionNacional.BLL.DTOs.MostrarPartidoDTO>

@{
    ViewData["Title"] = "Emitir voto";

    var votante =
        ViewBag.Votante as VotacionNacional.BLL.DTOs.VotanteDto;

    string cedula =
        ViewBag.Cedula?.ToString() ?? "";
}

<div class="form-page">

    <div class="form-page-header">

        <div>

            <span class="management-eyebrow">
                Elecciones
            </span>

            <h1 class="management-title">
                Emitir voto
            </h1>

            <p class="management-description">
                Seleccione el partido político de su preferencia.
            </p>

        </div>

    </div>

    <div class="form-card">

        <div class="form-card-banner">

            <div class="form-banner-icon">
                <i class="bi bi-ballot-fill"></i>
            </div>

            <div>
                <h2>Información del votante</h2>
                <p>
                    @votante?.Nombre
                    @votante?.PrimerApellido
                    @votante?.SegundoApellido
                </p>
            </div>

        </div>

        <div class="form-card-body">

            <form asp-action="Votar" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="Cedula"
                       value="@cedula" />

                <div class="row g-4">

                    @foreach (var partido in Model)
                    {
                        <div class="col-md-6">

                            <label class="card h-100 border-2 p-3">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="radio"
                                           name="PartidoId"
                                           value="@partido.PartidoId"
                                           required />

                                    <span class="fw-bold fs-5 ms-2">
                                        @partido.Siglas
                                    </span>

                                </div>

                                <div class="mt-3">

                                    @if (!string.IsNullOrWhiteSpace(partido.ImagenUrl))
                                    {
                                        <img src="@partido.ImagenUrl"
                                             class="img-fluid rounded mb-3"
                                             style="max-height:120px;"
                                             alt="@partido.Nombre" />
                                    }

                                    <h5>
                                        @partido.Nombre
                                    </h5>

                                </div>

                            </label>

                        </div>
                    }

                </div>

                <div class="form-actions mt-4">

                    <button type="submit"
                            class="btn-form-primary">

                        <i class="bi bi-check2-circle"></i>
                        Registrar voto

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>